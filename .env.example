# ==============================================
# Controle de Bordo - Variáveis de Ambiente
# ==============================================
# Copie para .env e preencha os valores necessários
# cp .env.example .env

# --- IA (fase 1: Claude API, opcional) ---
ANTHROPIC_API_KEY=

# --- IA (fase 2: Ollama local, opcional) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Notificações Push (ntfy.sh, opcional) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=controle-de-bordo

# --- Banco de Dados ---
BORDO_DB_PATH=data/bordo.db

# --- Android (ponte mobile, opcional) ---
ADB_HOST=
ADB_PORT=5555

# --- Desktop (Pop!_OS, opcional) ---
BORDO_BLOCKED_HOSTS=
BORDO_FOCUS_MODE=off
